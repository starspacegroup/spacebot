{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// allowJs/checkJs stay on during the JS→TS migration so any
		// not-yet-renamed .js files still resolve. checkJs is off so the
		// migration doesn't require fully-typed JS before renaming.
		"allowJs": true,
		"checkJs": false,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		// Gradual-typing baseline for the JS→TS migration. SvelteKit's
		// generated config is `strict`, which flags ~7k implicit-any/null
		// errors on freshly-renamed files. We relax strictness so `typecheck`
		// is a usable gate today and can be tightened module-by-module as
		// real types are added. Flip these back on as the codebase hardens.
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"skipLibCheck": true,
		// Kit 3 extends "$app/tsconfig", a package export bun cannot follow at
		// runtime. The pm2 gateway runs under bun and needs $lib from here, or it
		// crash-loops on "Cannot find module '$lib/log.js'" (2026-10-28).
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	// Kit 3 no longer generates include/exclude; these match what kit 2 wrote.
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.js"],
	"exclude": ["node_modules", "src/service-worker.js", "src/service-worker.ts"]
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// except $lib which is handled by https://svelte.dev/docs/kit/configuration#files
	//
	// If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
	// from the referenced tsconfig.json - TypeScript does not merge them in
}
