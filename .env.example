# Environment variables for local development
# Copy this to .env and fill in your values

# ============================================
# Origin Configuration (for tunnels/proxies)
# ============================================
# When using a Cloudflare tunnel or reverse proxy, set this to the external URL
# so OAuth redirects work correctly. Comment out for regular local dev.
# ORIGIN=https://spacebot-dev.starspace.group

# Dev-only, local machine only — NOT a production secret, do not add to
# scripts/setup-secrets.ts. Used by scripts/dev-tunnel.ts to manage DNS
# records directly via the Cloudflare API (cloudflared's local cert can be
# scoped to the wrong zone if you've used it for other projects).
# Create at: Cloudflare dashboard > My Profile > API Tokens > Create Token
#   Permission: Zone / DNS / Edit, Zone Resources: starspace.group
# CLOUDFLARE_DNS_API_TOKEN=your_dns_edit_token_here

# Discord Bot Configuration
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_INVITE_PERMISSIONS=8

# Public community links
PUBLIC_SUPPORT_DISCORD_URL=
PUBLIC_BOT_VOTE_URL=
PUBLIC_BOT_REVIEW_URL=

# Observability
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Server-side Sentry (Cloudflare Workers) — per-request init in hooks.server.ts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# API rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX_REQUESTS=120

# Admin Configuration (comma-separated Discord user IDs)
ADMIN_USER_IDS=your_discord_user_id_here

# ============================================
# Development Auth Bypass
# ============================================
# Set to "true" to enable dev login bypass (skips Discord OAuth)
# This adds a "Dev Login" button on /login and enables:
#   - /dev-login - Instantly logs in as dev user
#   - /dev-logout - Logs out dev user  
#   - ?dev_auth=true - Query param to auto-login on any page
DEV_AUTH_BYPASS=true

# Optional: Customize the dev user identity
# If not set, DEV_USER_ID defaults to first ADMIN_USER_IDS
# DEV_USER_ID=your_discord_user_id_here
# DEV_USERNAME=DevUser
# DEV_GLOBAL_NAME=Development User

# ============================================
# Cloudflare AI Configuration (for DM AI chat)
# ============================================
# Required for the bot to respond to DMs with AI
# Find your Account ID in the Cloudflare dashboard sidebar
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# Generate an AI token from Cloudflare dashboard: AI > Workers AI
CLOUDFLARE_AI_TOKEN=your_cloudflare_ai_token_here

# Optional: AI Gateway ID for analytics/rate limiting
# CLOUDFLARE_AI_GATEWAY_ID=your_gateway_id_here

# Optional: Override the default AI model (@cf/meta/llama-3.3-70b-instruct-fp8-fast)
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ============================================
# Local Ollama (LOCAL DEV ONLY — default LLM)
# ============================================
# Run the DM AI chat against a local Ollama model instead of Cloudflare Workers AI.
# Dev-only: Cloudflare Workers (production) cannot reach localhost, so leave these
# UNSET in production — Workers AI stays the prod default. First run: `ollama pull gemma3:4b`.
#
# Set AI_PROVIDER=ollama to route the dashboard/gateway DM AI to Ollama.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
#
# Local runner LLM provider (scripts/local-runner). The runner already defaults to
# Ollama + gemma3:4b when Ollama is running; these only override that default.
# SPACEBOT_LLM_PROVIDER=ollama
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_MODEL=gemma3:4b

# ============================================
# MCP / Database Configuration
# ============================================
# Cloudflare API token for MCP database tool access (D1 queries from AI)
# Needs D1 read permissions. Not needed if using local DB.
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Read-only D1 access for `bun run db:query` (production diagnostics).
# Needs only Account -> D1 -> Read. See docs/production-queries.md
CLOUDFLARE_D1_TOKEN=

# Set to "true" to use local SQLite database instead of Cloudflare D1 API
# This is faster for local development and doesn't require API permissions
MCP_USE_LOCAL_DB=true
