{
	"name": "spacebot",
	"private": true,
	"version": "0.0.1",
	"packageManager": "bun@1.3.13",
	"type": "module",
	"scripts": {
		"dev": "VITE_HMR=true vite dev",
		"dev:hmr": "VITE_HMR=true vite dev",
		"dev:no-hmr": "VITE_HMR=false vite dev",
		"dev:wrangler": "wrangler pages dev .svelte-kit/cloudflare --port 4269 --compatibility-date=2024-01-26 --persist-to .wrangler/state",
		"dev:tunnel": "cloudflared tunnel run spacebot",
		"prod:tunnel": "cloudflared tunnel run spacebot",
		"dev:gateway": "bun src/lib/discord/gateway.ts",
		"gateway": "bun scripts/prod-start.ts",
		"gateway:stop": "pm2 stop all",
		"gateway:restart": "pm2 restart spacebot-gateway",
		"gateway:logs": "pm2 logs",
		"gateway:status": "pm2 status",
		"build": "bun install --frozen-lockfile && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"register-commands": "bun scripts/register-commands.ts",
		"register-linked-role": "bun scripts/register-linked-role-metadata.ts",
		"runner": "bun run scripts/local-runner/index.ts",
		"runner:headless": "bun run scripts/local-runner/index.ts --headless",
		"runner:local": "SPACEBOT_API_URL=http://localhost:4269 bun run scripts/local-runner/index.ts",
		"runner:build": "bun build --compile --target=bun-linux-x64 scripts/local-runner/index.ts --outfile dist/spacebot-runner",
		"runner:install": "bun run runner:build && install -Dm755 dist/spacebot-runner \"$HOME/.local/bin/spacebot-runner\" && echo \"Installed: $HOME/.local/bin/spacebot-runner\"",
		"runner:bridge:readme": "cat local-runner-vscode-bridge/README.md",
		"db:create": "wrangler d1 create spacebot-logs",
		"db:migrate": "bun scripts/migrate.ts",
		"db:migrate:smart": "bun scripts/migrate-if-needed.ts",
		"db:migrate:local": "bun scripts/migrate.ts --local",
		"gateway:latency": "bun scripts/gateway-latency.ts",
		"gateway:latency:history": "bun scripts/gateway-latency.ts --history",
		"db:push": "bun scripts/push-data.ts --confirm",
		"db:push:dry": "bun scripts/push-data.ts",
		"secrets:setup": "bun scripts/setup-secrets.ts --confirm",
		"secrets:setup:dry": "bun scripts/setup-secrets.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.41.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.65.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.9.3",
		"@vitest/coverage-v8": "^4.1.9",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^7.3.5",
		"vitest": "^4.1.9"
	},
	"optionalDependencies": {
		"better-sqlite3": "^12.11.1"
	},
	"dependencies": {
		"@opentui/core": "^0.2.16",
		"@opentui/react": "^0.2.16",
		"@discordjs/rest": "^2.6.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"discord-api-types": "^0.38.49",
		"discord-interactions": "^4.4.0",
		"discord.js": "^14.26.4",
		"dotenv": "^17.4.2",
		"react": "^19.2.7",
		"react-devtools-core": "^7.0.1",
		"ws": "^8.21.0"
	}
}
