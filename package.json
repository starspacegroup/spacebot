{
	"name": "spacebot",
	"private": true,
	"version": "0.0.1",
	"packageManager": "bun@1.3.13",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:hmr": "set VITE_HMR=true && vite dev",
		"dev:wrangler": "wrangler pages dev .svelte-kit/cloudflare --port 4269 --compatibility-date=2024-01-26 --persist-to .wrangler/state",
		"dev:tunnel": "cloudflared tunnel run spacebot",
		"prod:tunnel": "cloudflared tunnel run spacebot",
		"dev:gateway": "bun src/lib/discord/gateway.js",
		"gateway": "bun scripts/prod-start.js",
		"gateway:stop": "pm2 stop all",
		"gateway:restart": "pm2 restart spacebot-gateway",
		"gateway:logs": "pm2 logs",
		"gateway:status": "pm2 status",
		"build": "bun install --frozen-lockfile && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"register-commands": "bun scripts/register-commands.js",
		"register-linked-role": "bun scripts/register-linked-role-metadata.js",
		"runner": "bun run scripts/local-runner/index.ts",
		"runner:headless": "bun run scripts/local-runner/index.ts --headless",
		"runner:local": "SPACEBOT_API_URL=http://localhost:4269 bun run scripts/local-runner/index.ts",
		"runner:bridge:readme": "cat local-runner-vscode-bridge/README.md",
		"db:create": "wrangler d1 create spacebot-logs",
		"db:migrate": "bun scripts/migrate.js",
		"db:migrate:local": "bun scripts/migrate.js --local",
		"gateway:latency": "bun scripts/gateway-latency.js",
		"gateway:latency:history": "bun scripts/gateway-latency.js --history",
		"db:push": "bun scripts/push-data.js --confirm",
		"db:push:dry": "bun scripts/push-data.js",
		"secrets:setup": "bun scripts/setup-secrets.js --confirm",
		"secrets:setup:dry": "bun scripts/setup-secrets.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.2",
		"@cloudflare/vite-plugin": "^1.21.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"svelte": "^5.45.6",
		"vite": "^7.2.6",
		"vitest": "^4.1.2"
	},
	"optionalDependencies": {
		"better-sqlite3": "^12.6.2"
	},
	"dependencies": {
		"@opentui/core": "^0.2.15",
		"@opentui/react": "^0.2.15",
		"@discordjs/rest": "^2.6.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"discord-api-types": "^0.38.37",
		"discord-interactions": "^4.4.0",
		"discord.js": "^14.25.1",
		"dotenv": "^17.2.3",
		"react": "^19.2.0",
		"react-devtools-core": "^7.0.1",
		"ws": "^8.18.3"
	}
}
